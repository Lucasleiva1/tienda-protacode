# Provider neutro. No hay ningún proveedor real integrado todavía.
PAYMENT_PROVIDER=none

# Canal de venta temporal. El Admin puede reemplazar el número inicial sin redeploy.
SALES_CHANNEL=whatsapp
WHATSAPP_NUMBER=5491150540281

# Credenciales administrativas (completar fuera del repositorio).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Solo desarrollo (next dev): precarga el login del Admin. Nunca cargarlas en Netlify.
ADMIN_DEV_EMAIL=
ADMIN_DEV_PASSWORD=

# Sesiones de clientes. Mínimo 32 caracteres; si falta, se deriva del secreto Admin.
CUSTOMER_SESSION_SECRET=

# Google OAuth (aplicación web). Callback: /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Confirmación de cuentas por email. La URL pública debe usar HTTPS en producción.
PUBLIC_SITE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Licencias. `none` es el valor seguro hasta configurar RXW Core 0.8.0.
# `mock` se admite únicamente en desarrollo/tests; producción lo bloquea.
LICENSE_PROVIDER=none
RXW_CORE_BASE_URL=
RXW_STORE_SERVICE_ID=
RXW_STORE_SERVICE_SECRET=
